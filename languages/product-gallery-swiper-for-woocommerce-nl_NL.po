#: admin/class-wdevs-gallery-swiper-admin.php:83
#: includes/class-wdevs-gallery-swiper-woocommerce.php:282
msgid "Settings"
msgstr "Instellingen"

#: includes/class-wdevs-gallery-swiper-activator.php:33
msgid ""
"This plugin requires WooCommerce. Please install and activate WooCommerce "
"before activating this plugin."
msgstr ""
"Deze plugin vereist WooCommerce. Installeer en activeer WooCommerce voordat "
"u deze plugin activeert."

#: includes/class-wdevs-gallery-swiper-woocommerce.php:96
msgid "Gallery Swiper"
msgstr "Galerij Swiper"

#: includes/class-wdevs-gallery-swiper-woocommerce.php:110
msgid "Gallery Swiper settings"
msgstr "Galerij Swiper instellingen"

#: includes/class-wdevs-gallery-swiper-woocommerce.php:112
msgid "Customize the Gallery slider settings."
msgstr "Pas de instellingen van de Gallery Slider aan."

#: includes/class-wdevs-gallery-swiper-woocommerce.php:116
msgid "Enable scrollbar"
msgstr "Schakel scrollbalk in"

#: includes/class-wdevs-gallery-swiper-woocommerce.php:118
msgid "Enable scrollbar for the slider"
msgstr "Schakel scrollbalk in voor de slider"

#: includes/class-wdevs-gallery-swiper-woocommerce.php:123
msgid "Enable pagination"
msgstr "Schakel paginering in"

#: includes/class-wdevs-gallery-swiper-woocommerce.php:125
msgid "Enable pagination for the slider"
msgstr "Schakel paginering in voor de slider"

#: includes/class-wdevs-gallery-swiper-woocommerce.php:130
msgid "Enable navigation"
msgstr "Schakel navigatie in"

#: includes/class-wdevs-gallery-swiper-woocommerce.php:132
msgid "Enable navigation for the slider"
msgstr "Schakel navigatie in voor de slider"

#: includes/class-wdevs-gallery-swiper-woocommerce.php:137
msgid "Enable variation images"
msgstr "Schakel variatie-afbeeldingen in"

#: includes/class-wdevs-gallery-swiper-woocommerce.php:139
msgid "Display variation images in the slider"
msgstr "Variatie-afbeeldingen weergeven in de slider"

#: includes/class-wdevs-gallery-swiper-woocommerce.php:144
msgid "Disable slider from"
msgstr "Schakel slider uit vanaf"

#: includes/class-wdevs-gallery-swiper-woocommerce.php:146
msgid ""
"When set, the slider will be disabled from the specified breakpoint upwards."
msgstr ""
"Indien ingesteld, wordt de slider uitgeschakeld vanaf het gespecificeerde "
"breekpunt en hoger."

#: includes/class-wdevs-gallery-swiper-woocommerce.php:149
msgid "Always enabled"
msgstr "Altijd ingeschakeld"

#: includes/class-wdevs-gallery-swiper-woocommerce.php:150
msgid "Disabled from 480px and up"
msgstr "Uitgeschakeld vanaf 480px en hoger"

#: includes/class-wdevs-gallery-swiper-woocommerce.php:151
msgid "Disabled from 768px and up"
msgstr "Uitgeschakeld vanaf 768px en hoger"

#: includes/class-wdevs-gallery-swiper-woocommerce.php:152
msgid "Disabled from 992px and up"
msgstr "Uitgeschakeld vanaf 992px en hoger"

#: includes/class-wdevs-gallery-swiper-woocommerce.php:153
msgid "Disabled from 1200px and up"
msgstr "Uitgeschakeld vanaf 1200px en hoger"

#: includes/class-wdevs-gallery-swiper-woocommerce.php:158
msgid "Enable hover on disabled slider"
msgstr "Schakel muisbeweging in bij uitgeschakelde slider"

#: includes/class-wdevs-gallery-swiper-woocommerce.php:160
msgid ""
"When the slider is disabled (above breakpoint), show the second image on "
"mouse hover."
msgstr ""
"Wanneer de slider is uitgeschakeld (boven breekpunt), de tweede "
"productafbeelding weergegeven bij het hoveren met de muis."

#: includes/class-wdevs-gallery-swiper-woocommerce.php:166
msgid "Theme color"
msgstr "Themakleur"

#: includes/class-wdevs-gallery-swiper-woocommerce.php:168
msgid "Choose the Swiper theme color"
msgstr "Kies de Swiper themakleur"

#. translators: %s: Link to author site.
#: includes/class-wdevs-gallery-swiper-woocommerce.php:207
#, php-format
msgid ""
"Product Gallery Swiper for WooCommerce is developed by %s. Your trusted "
"WordPress & WooCommerce plugin partner from the Netherlands."
msgstr ""
"Product Gallery Swiper for WooCommerce is ontwikkeld door %s. Uw betrouwbare "
"WordPress & WooCommerce pluginpartner uit Nederland."

#: includes/class-wdevs-gallery-swiper-woocommerce.php:256
msgid "Documentation"
msgstr "Documentatie"

#. Plugin Name of the plugin/theme
msgid "Product Gallery Swiper for WooCommerce"
msgstr "Productgalerij Swiper voor WooCommerce"

#. Plugin URI of the plugin/theme
msgid "https://products.wijnberg.dev"
msgstr "https://products.wijnberg.dev"

#. Description of the plugin/theme
msgid ""
"Enhances WooCommerce product images display on product listing sections, "
"providing a responsive and touch-friendly swiper."
msgstr ""
"Verbetert de weergave van WooCommerce productafbeeldingen in "
"productoverzichten, met een responsieve en gebruiksvriendelijke slider."

#. Author of the plugin/theme
msgid "Wijnberg Developments"
msgstr "Wijnberg Developments"
